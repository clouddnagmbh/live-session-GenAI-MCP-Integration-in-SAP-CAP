{
  "name": "gen-ai-mcp",
  "version": "1.0.0",
  "description": "GenAI & MCP Integration in SAP CAP — live session demos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@cap-js/ai": "1.1.0",
    "@sap-ai-sdk/orchestration": "2.15.0",
    "@sap/cds": "10.0.6"
  },
  "devDependencies": {
    "@cap-js/sqlite": "3.0.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy"
  },
  "cds": {
    "features": {
      "assert_integrity": "DB"
    },
    "log": {
      "levels": {
        "@cap-js/ai": "debug"
      }
    },
    "requires": {
      "LLM": {
        "model": "llm/LLM-mock",
        "kind": "llm-mocked"
      },
      "kinds": {
        "llm-mocked": {},
        "llm-aicore": {}
      },
      "[hybrid]": {
        "LLM": {
          "model": "llm/LLM",
          "kind": "llm-aicore"
        }
      },
      "[production]": {
        "LLM": {
          "model": "llm/LLM",
          "kind": "llm-aicore"
        }
      }
    }
  }
}
